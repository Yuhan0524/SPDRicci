{
  "model": {
    "activation": "tgrelu",
    "beta": 300.0,
    "bimap_max_delta": 0.08,
    "bimap_min_singular_value": 0.1,
    "classifier_dropout": 0.5,
    "epsilon": 0.1,
    "feature_dropout": 0.0,
    "layers": 2,
    "spd_dim": 16,
    "spd_floor": 0.0001,
    "tgrelu_delta": 0.2
  },
  "training": {
    "epochs": 300,
    "gradient_clip": 5.0,
    "learning_rate": 0.03,
    "optimizer": "adam",
    "precision": "float32",
    "weight_decay": 0.0005
  }
}
